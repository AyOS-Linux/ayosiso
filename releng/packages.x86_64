# === Ayder (установщик) ===
ayder
# === Драйверы / видео ===
# Microcode: intel-ucode + amd-ucode ставятся в squashfs, а mkarchiso
# (проверено в собранном ISO) вшивает их в initramfs-linux.img
# (early_cpio + kernel/x86/microcode/{GenuineIntel,AuthenticAMD}.bin) —
# Live грузится с микрокодом обоих производителей ЦП.
# nvidia: владелец выбрал DKMS-вариант (nvidia-dkms вместо nvidia-open) —
# модуль собирается под установленное ядро; linux-headers обязателен,
# иначе dkms не сможет собрать модуль при сборке образа.
mesa
vulkan-mesa-implicit-layers
nvidia-dkms
linux-headers
nvidia-utils
nvidia-settings
vulkan-radeon
vulkan-intel
# libva-mesa-driver слит в mesa (VA-API radeonsi/nouveau драйверы внутри mesa)
# mesa-vdpau слит в mesa (VDPAU входит в mesa с 2023)
intel-media-driver
libva-intel-driver
xf86-video-amdgpu
# nvidia в Live тоже ставится явным списком (см. выше) — «динамической»
# подстановки nvidia в customize_airootfs.sh/build.sh НЕТ.
# === Утилиты Live ===
fastfetch
xdg-utils
polkit
accountsservice
xdg-desktop-portal
xdg-desktop-portal-gtk
arch-install-scripts
nbd
squashfs-tools
rsync
