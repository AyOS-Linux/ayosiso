# libva-mesa-driver слит в mesa (VA-API radeonsi/nouveau драйверы внутри mesa)
# mesa-vdpau слит в mesa (VDPAU входит в mesa с 2023)
intel-media-driver
libva-intel-driver
xf86-video-amdgpu
