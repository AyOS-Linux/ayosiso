# AyOS Material 26.11 — Live-пакеты (Xfce Live-сессия + установщик Calamares)
# По одному пакету на строку; '#' — комментарии. Все пакеты существуют в репах Arch.
# === База ===
base
linux
linux-firmware
mkinitcpio
mkinitcpio-archiso
mkinitcpio-nfs-utils
amd-ucode
intel-ucode
base-devel
nano
vim
sudo
git
wget
curl
# === Сеть ===
networkmanager
network-manager-applet
nm-connection-editor
wpa_supplicant
iwd
wireless-regdb
# === Bluetooth ===
# Bluetooth: bluez + bluez-utils + bluez-obex (пакета 'bluetooth' в Arch нет)
bluez
bluez-utils
bluez-obex
# === Звук / кодеки ===
pipewire
pipewire-pulse
pipewire-alsa
pipewire-jack
