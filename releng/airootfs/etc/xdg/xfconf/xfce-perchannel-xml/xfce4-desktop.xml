<?xml version="1.0" encoding="UTF-8"?>
<!-- AyOS Material 26.11 - дефолтные обои AyOS Light (Xfce):
     monitor0/workspace0 - обобщённый дефолт, реальные мониторы подхватят. -->
<channel name="xfce4-desktop" version="1.0">
  <property name="backdrop" type="empty">
    <property name="screen0" type="empty">
      <property name="monitor0" type="empty">
        <property name="workspace0" type="empty">
          <property name="image-style" type="uint" value="5"/>
          <property name="image-path" type="string" value="/usr/share/backgrounds/ayos/light.png"/>
        </property>
      </property>
    </property>
  </property>
</channel>
