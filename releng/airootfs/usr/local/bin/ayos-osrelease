#!/usr/bin/env bash
# AyOS Stuff 26.3 — /usr/local/bin/ayos-osrelease
# Вызывается из Calamares shellprocess в chroot целевой системы.
# Пишет финальный /etc/os-release установленной системы.
# Редакций нет: одна AyOS Stuff с KDE Plasma.

set -euo pipefail

# Аргумент (имя «редакции») сохранён для совместимости с конфигом установщика
# ayder: shellprocess@ayos_osrelease вызывает `ayos-osrelease everyday`.
_ignored="${1:-}"

cat > /etc/os-release <<'EOF'
NAME="AyOS Stuff"
PRETTY_NAME="AyOS Stuff 26.3"
ID=ayos
ID_LIKE=arch
BUILD_ID=26.3
VARIANT_ID=kde
VARIANT="KDE Plasma"
HOME_URL="https://github.com/AyOS-Linux/ayosiso"
DOCUMENTATION_URL="https://github.com/AyOS-Linux/ayosiso/wiki"
LOGO=ayos
EOF
chmod 644 /etc/os-release

# os-release-манжеты для lsb_release-совместимости не пишем: systemd читает os-release.

exit 0
