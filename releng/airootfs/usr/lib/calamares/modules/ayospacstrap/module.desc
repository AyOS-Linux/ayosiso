# SPDX-FileCopyrightText: no
# SPDX-License-Identifier: CC0-1.0
#
# AyOS: честная установка — pacstrap свежей системы из репозиториев
# в примонтированный target, вместо копии squashfs (unpackfs ушёл).
#
# Раскладка путей (Calamares 3.4, проверено практикой):
#   module.desc + main.py  -> /usr/lib/calamares/modules/<name>/   (системный поиск, всегда)
#   <name>.conf            -> /etc/calamares/modules/<name>.conf   (конфиг ищется уровнем выше)
# build.sh раскладывает файлы сам.
---
type:       "job"
name:       "ayospacstrap"
interface:  "python"
script:     "main.py"
